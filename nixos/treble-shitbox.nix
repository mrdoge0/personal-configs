##
## HW-SPECIFIC NIXOS CONFIG FOR MY PC
##
{
  config,
  lib,
  pkgs,
  ...
}:

# This is the machine-specific config split for my main PC.

# -- TARGET COMPUTER'S SPECS --
#   - My custom desktop PC  -
# CPU:         AMD Ryzen 5 1600AF
# RAM:         16GB 3000MT/s DDR4 (Corsair Vengeance LPX 2x8GB)
# Motherboard: GIGABYTE B450M S2H
# dGPU:        Intel Arc A750 8GB Limited Edition
# iGPU:        no iGPU
# Storage:
#   OS NVMe:   WD PC SN530 256GB
#   Home SSD:  HI-LEVEL 120GB SATA
#   Data HDD:  Toshiba 2TB 7200RPM 3.5"
# CPU Cooler:  Thermalright Peerless Assasin 140 White
# Case:        ASUS A21 Plus White
# PSU:         MSI MAG A500DN (500W, 80+ White)
# Monitor:     AOC G2260VWQ6 (21.5" 1080p 75Hz TN)
# Keyboard:    Logitech K120
# Mouse:       Razer DeathAdder Essential White
# Headset:     HAVIT Gamenote Fuxi-H3
# Bluetooth:   MERCUSYS MA530

{
  # Boot stuff
  boot = {
    # Use the systemd-boot bootloader
    loader = {
      efi.canTouchEfiVariables = true;
      timeout = 0;
      systemd-boot = {
        enable = true;
        consoleMode = "max";
        editor = true;
        memtest86.enable = true;
      };
    };

    # Kernel parameters (machine-specific)
    kernelParams = [
      # IOMMU on AMD CPU
      "amd_iommu=on"
      "iommu=pt"

      # Intel Arc: Ebforce "xe" driver (Performance sucks and I get GPU hangs in some games w/ "i915" (which is Alchemist's default))
      "i915.force_probe=!56a1"
      "xe.force_probe=56a1"

      # Monitor TTY config
      "video=DP-2:1920x1080@75"
    ];
  };

  # Hostname
  networking.hostName = "Shitbox";

  # Filesystems (root and esp are expected from the autogenerated hardware-configuration.nix)
  fileSystems = {
    # Enable discard for root (WD SN530 256GB)
    "/".options = [ "discard" ];

    # No-name 120GB DRAM-less SATA SSD - Home directory
    "/home" = {
      device = "/dev/disk/by-uuid/5e1c397a-ccf5-4767-be16-3603acdfff89";
      fsType = "f2fs";
      options = [ "discard" ];
    };

    # Toshiba 2TB HDD - Bulk
    "/HDD" = {
      device = "/dev/disk/by-uuid/868f24b3-180e-4ac6-9721-7375ab3ec272";
      fsType = "btrfs";
    };
  };

  # Set up ZRAM
  zramSwap = {
    enable = true;
    memoryMax = 12884901888;
  };

  # Services
  services = {
    # Fwupd
    fwupd.enable = true;

    # Auto scrub BTRFS on HDD
    btrfs.autoScrub = {
      enable = true;
      interval = "weekly";
      fileSystems = [ "/HDD" ];
    };

    # BlueMan (potentially the worst BT client, but..)
    blueman.enable = true;

    # Extra WirePlumber config to enforce A2DP
    pipewire.wireplumber.extraConfig."60-bluez-a2dp-only" = {
      "monitor.bluez.properties"."bluez5.roles" = [ "a2dp_sink" "a2dp_source" ];
      "wireplumber.settings"."bluetooth.autoswitch-to-headset-profile" = false;
    };
  };

  # HW
  hardware = {
    # Intel Arc: config for HW tree
    graphics = {
      enable = true;
      enable32Bit = true;
      extraPackages = with pkgs; [
        intel-compute-runtime
        intel-media-driver
        vpl-gpu-rt
      ];
    };

    # Intel Arc: it is an awesome idea to enable redist fw
    enableRedistributableFirmware = true;

    # OpenRazer
    openrazer.enable = true;

    # BlueZ
    bluetooth = {
      enable = true;
      settings.General = {
        Experimental = true;
        Enable = "Source,Sink,Media,Socket";
      };
    };
  };

  # Environment
  environment = {
    # Vars
    sessionVariables = rec {
      # Intel Arc: use Intel VAAPI
      LIBVA_DRIVER_NAME = "iHD";
    };

    # HW-related packages
    systemPackages = with pkgs; [
      # OpenRazer
      openrazer-daemon
      polychromatic

      # Btrfs
      btrfs-assistant
      btrfs-progs
    ];
  };

  # Add Teto to openrazer group
  users.users.Teto.extraGroups = [ "openrazer" ];
}
