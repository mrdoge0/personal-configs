##
## HW-SPECIFIC NIXOS CONFIG FOR MY PC
##
{
  config,
  lib,
  pkgs,
  ...
}:

{
  # Boot stuff
  boot = {
    # Use the latest kernel
    kernelPackages = pkgs.linuxPackages_latest;

    # Use the systemd-boot boot manager
    loader = {
      efi.canTouchEfiVariables = true;
      timeout = 0;
      systemd-boot = {
        enable = true;
        consoleMode = "max";
        editor = true;
        memtest86.enable = true;
      };
    };

    # Kernel parameters (machine-specific)
    kernelParams = [
      # IOMMU on AMD CPU
      "amd_iommu=on"
      "iommu=pt"

      # Intel Arc: GuC on i915 driver (I have no idea will i915 or xe be used on Alchemist, so..)
      "i915.enable_guc=3"

      # Monitor TTY config
      "video=DP-2:1920x1080@75"
    ];
  };

  # Hostname
  networking.hostName = "Shitbox";

  # Filesystems (root and esp are expected from the autogenerated hardware-configuration.nix)
  fileSystems = {
    # Enable discard for root (WD SN530 256GB)
    "/".options = [ "discard" ];

    # No-name 120GB DRAM-less SATA SSD - Home directory
    "/home" = {
      device = "/dev/disk/by-uuid/5e1c397a-ccf5-4767-be16-3603acdfff89";
      fsType = "f2fs";
      options = [ "discard" ];
    };

    # Toshiba 2TB HDD - Bulk
    "/HDD" = {
      device = "/dev/disk/by-uuid/868f24b3-180e-4ac6-9721-7375ab3ec272";
      fsType = "btrfs";
    };
  };

  # Set up ZRAM
  zramSwap = {
    enable = true;
    memoryMax = 12884901888;
  };

  # Services
  services = {
    # Auto scrub BTRFS on HDD
    btrfs.autoScrub = {
      enable = true;
      interval = "weekly";
      fileSystems = [ "/HDD" ];
    };

    # BlueMan (potentially the worst BT client, but..)
    blueman.enable = true;
  };

  # HW
  hardware = {
    # Intel Arc: config for HW tree
    graphics = {
      enable = true;
      enable32Bit = true;
      extraPackages = with pkgs; [
        intel-compute-runtime
        intel-media-driver
        vpl-gpu-rt
      ];
    };

    # Intel Arc: it is an awesome idea to enable redist fw
    enableRedistributableFirmware = true;

    # OpenRazer
    openrazer.enable = true;

    # BlueZ
    bluetooth = {
      enable = true;
      settings.General = {
        Experimental = true;
        Enable = "Source,Sink,Media,Socket";
      };
    };
  };

  # Environment
  environment = {
    # Vars
    sessionVariables = {
      # Intel Arc: use Intel VAAPI
      LIBVA_DRIVER_NAME = "iHD";
    };

    # HW-related packages
    systemPackages = with pkgs; [
      # OpenRazer
      openrazer-daemon
      polychromatic

      # Btrfs
      btrfs-assistant
      btrfs-progs
    ];
  };

  # Add Teto to openrazer group
  users.users.Teto.extraGroups = [ "openrazer" ];
}
