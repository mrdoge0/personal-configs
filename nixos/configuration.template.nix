##
## DUMB TERMINAL TO STITCH MY NIXOS CONFIG TOGETHER
## TEMPLATE
##
{
  config,
  lib,
  pkgs,
  ...
}:

# This file is to take place as configuration.nix, and is a dumb terminal to pull my repo,
# import the autogenerated hardware-configuration.nix, the machine's treble-*.nix,
# the main.nix and if enabled the main-plus.nix. Only as template in the repo since it's
# meant to also store the password.

let
  # Fetch my repo
  personal-configs = builtins.fetchGit {
    url = "https://github.com/mrdoge0/personal-configs";
    ref = "main";
  };
in
{
  # Stitch everything together
  imports = [
    # Internal: Autogenerated HW config
    ./hardware-configuration.nix

    # Repo:     HW-specific for this computer
    "${personal-configs}/nixos/treble-shitbox.nix"

    # Repo:     Main
    "${personal-configs}/nixos/main.nix"

    # Repo:     Main Plus (comment to disable)
    "${personal-configs}/nixos/main-plus.nix"
  ];

  # Declare the password
  users.users.Teto.hashedPassword = "(hashed password here)";
}
