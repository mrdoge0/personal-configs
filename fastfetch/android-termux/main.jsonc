{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	
	// Logo image
	"logo": {
		"type": "none"
	},
	
	"modules": [
		// Title
		{
			"type": "title",
			"format": "━━━━━━┫ {user-name-colored} @ {host-name-colored} ┣━━━━━━"
		},

		"break",

		// Software Corner
		
		{
			"type": "os",
			"key": "┏ 󰀲 ",
			"keyColor": "green",
			"format": "{name} {version}"
		},

		{
			"type": "kernel",
			"key": "┣ 󰌽 ",
			"keyColor": "green",
			"format": "{release}"
		},

		{
			"type": "packages",
			"key": "┣ 󰏓 ",
			"keyColor": "green",
			"format": "{dpkg} (Termux)"
		},

		{
			"type": "de",
			"key": "┣  ",
			"keyColor": "green",
			"format": "{pretty-name} {version}"
		},

		{
			"type": "wm",
			"key": "┣ 󱂬 ",
			"keyColor": "green",
			"format": "{pretty-name} ({protocol-name})"
		},

		{
			"type": "terminal",
			"key": "┣  ",
			"keyColor": "green",
			"format": "{pretty-name} {version}"
		},

		{
			"type": "localip",
			"key": "┣ 󰩟 ",
			"keyColor": "green",
			"format": "{ipv4}"
		},
		
		{
			"type": "locale",
			"key": "┗  ",
			"keyColor": "green"
		},

		"break",

		// Hardware Corner

		{
			"type": "host",
			"key": "┏ 󰇅 ",
			"keyColor": "green"
		},

		{
			"type": "cpu",
			"key": "┣ 󰻠 ",
			"keyColor": "green",
			"format": "{name} ({cores-physical}C / {cores-logical}T @ {freq-max})"
		},
		
		{
			"type": "gpu",
			"key": "┣ 󰈐 ",
			"keyColor": "green",
			"format": "{vendor} {name}"
		},
		
		{
			"type": "memory",
			"key": "┣ 󰍛 ",
			"keyColor": "green",
			"format": "{used} / {total} ({percentage})"
		},
		
        	{
			"type": "swap",
			"key": "┃ ┗ 󰓡 ",
			"keyColor": "green",
			"format": "[ZRAM] {used} / {total} ({percentage})"
		},
		
		{
			"type": "disk",
			"key": "┣ 󰉋 ",
			"keyColor": "green",
			"format": "[{mountpoint}] {size-used} / {size-total} ({size-percentage})"
		},
		
		{
			"type": "display",
			"key": "┣ 󰍹 ",
			"keyColor": "green",
			"format": "[{name}] {width}x{height} @ {refresh-rate} (x {scale-factor})"
		},
		
		{
			"type": "uptime",
			"key": "┗ 󰁝 ",
			"keyColor": "green",
			"format": "{formatted}"
		},
		
		"break"//,

		// Customization Corner
		
		//{
		//	"type": "theme",
		//	"key": "┏ 󰃣 ",
		//	"keyColor": "green"
		//},
		
		//{
		//	"type": "icons",
		//	"key": "┣  ",
		//	"keyColor": "green"
		//},
		
		//{
		//	"type": "font",
		//	"key": "┣ 󰛖 ",
		//	"keyColor": "green",
		//	"format": "{font2}"
		//},
		
		//{
		//	"type": "terminalfont",
		//	"key": "┃ ┗  ",
		//	"keyColor": "green",
		//	"format": "{combined}"
		//},
		
		//{
		//	"type": "cursor",
		//	"key": "┗ 󰇀 ",
		//	"keyColor": "green"
		//}
	]
}
